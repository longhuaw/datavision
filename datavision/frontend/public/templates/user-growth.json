{
  "name": "用户增长分析",
  "description": "用户注册趋势、活跃度、等级分布、地区覆盖",
  "category": "运营",
  "theme": "dark",
  "width": 1920,
  "height": 1080,
  "refresh_interval": 120,
  "components": [
    {
      "chart_type": "card",
      "chart_name": "总用户数",
      "position": { "x": 0, "y": 0, "w": 3, "h": 2 },
      "config": { "metrics": [{ "field": "id", "aggregation": "count" }], "dimensions": [] }
    },
    {
      "chart_type": "card",
      "chart_name": "VIP用户数",
      "position": { "x": 3, "y": 0, "w": 3, "h": 2 },
      "config": { "metrics": [{ "field": "id", "aggregation": "count" }], "dimensions": [], "filters": [{ "field": "user_level", "operator": "=", "value": "vip" }] }
    },
    {
      "chart_type": "card",
      "chart_name": "活跃率",
      "position": { "x": 6, "y": 0, "w": 3, "h": 2 },
      "config": { "metrics": [{ "field": "status", "aggregation": "count" }], "dimensions": [] }
    },
    {
      "chart_type": "card",
      "chart_name": "人均积分",
      "position": { "x": 9, "y": 0, "w": 3, "h": 2 },
      "config": { "metrics": [{ "field": "points", "aggregation": "avg" }], "dimensions": [] }
    },
    {
      "chart_type": "line",
      "chart_name": "用户注册趋势",
      "position": { "x": 0, "y": 2, "w": 8, "h": 4 },
      "config": {
        "dimensions": [{ "field": "reg_date", "order": 1 }],
        "metrics": [{ "field": "id", "aggregation": "count", "order": 1 }]
      }
    },
    {
      "chart_type": "pie",
      "chart_name": "用户等级分布",
      "position": { "x": 8, "y": 2, "w": 4, "h": 4 },
      "config": {
        "dimensions": [{ "field": "user_level", "order": 1 }],
        "metrics": [{ "field": "id", "aggregation": "count", "order": 1 }]
      }
    },
    {
      "chart_type": "bar",
      "chart_name": "各地区用户分布",
      "position": { "x": 0, "y": 6, "w": 6, "h": 4 },
      "config": {
        "dimensions": [{ "field": "region", "order": 1 }],
        "metrics": [{ "field": "id", "aggregation": "count", "order": 1 }]
      }
    },
    {
      "chart_type": "bar",
      "chart_name": "各等级平均积分",
      "position": { "x": 6, "y": 6, "w": 6, "h": 4 },
      "config": {
        "dimensions": [{ "field": "user_level", "order": 1 }],
        "metrics": [{ "field": "points", "aggregation": "avg", "order": 1 }]
      }
    }
  ]
}
