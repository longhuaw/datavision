# ==================== 应用配置 ====================
APP_NAME=DataVision
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# ==================== 数据库配置 ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=datavision
MYSQL_PASSWORD=datavision123
MYSQL_DATABASE=datavision
DATABASE_URL=mysql+asyncmy://datavision:datavision123@localhost:3306/datavision

# ==================== Redis配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== JWT配置 ====================
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== LLM配置 (NL2SQL) ====================
LLM_PROVIDER=openai  # openai | local | custom
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# ==================== 文件存储 ====================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== 日志 ====================
LOG_LEVEL=INFO
LOG_DIR=./logs
